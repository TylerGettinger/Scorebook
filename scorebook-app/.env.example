# Copy this file to .env.local for local dev, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: adds a simple lock screen so casual link-guessers can't get in.
# Leave blank to disable. This is NOT real security (see README) — it just
# adds friction beyond "have the URL".
VITE_APP_PASSCODE=
